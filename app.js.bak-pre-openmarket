const ALLOWED = ['scan', 'check', 'sub', 'unsub', 'signals', 'pnl', 'trades', 'status', 'markets', 'help'];
function encodeCmd(cmd) {           // "/check 7203.T" -> "check_7203_T", "/scan US UK" -> "scan_US-UK"
  const [c, ...a] = cmd.trim().replace(/^\//, '').split(/\s+/);
  const v = { subscribe: 'sub', unsubscribe: 'unsub' }[c] || c;
  const args = a.map(x => x.replace(/[^A-Za-z0-9.\-]/g, '').replace(/\./g, '_'));
  const p = args.length ? v + '_' + args.join(v === 'check' ? '' : '-') : v;
  return p.slice(0, 64);
}
function haptic(t) { try { tg && tg.HapticFeedback && tg.HapticFeedback.impactOccurred(t || 'light'); } catch (e) {} }
function botCmd(cmd) {
  haptic('medium');
  const bot = (D.status && D.status.bot_username) || 'StockingTradeBot';
  // sendData only works when the app was opened from the bot's keyboard button (no query_id)
  if (inTG && !tg.initDataUnsafe.query_id && tg.sendData) {
    try { tg.sendData(JSON.stringify({ cmd })); return; } catch (e) {}
  }
  const url = `https://t.me/${bot}?start=${encodeCmd(cmd)}`;
  if (inTG && tg.openTelegramLink) tg.openTelegramLink(url);
  else window.open(url, '_blank');
}
function toast(msg) {
  if (tg && tg.showPopup && inTG) { try { return tg.showAlert(msg); } catch (e) {} }
  const d = document.createElement('div'); d.className = 'card'; d.style.cssText = 'position:fixed;left:10px;right:10px;bottom:70px;z-index:9';
  d.textContent = msg; document.body.appendChild(d); setTimeout(() => d.remove(), 2500);
}

/* ---------------- data ---------------- */
async function load() {
  const t = Date.now();
  const names = ['status', 'signals', 'pnl', 'trades', 'schedule', 'backtest'];
  await Promise.all(names.map(n => fetch(`data/${n}.json?t=${t}`).then(r => r.ok ? r.json() : null).then(j => D[n] = j).catch(() => D[n] = null)));
  if (!D.status) throw new Error('data not published yet');
  $('#updated').textContent = 'Updated ' + ago(D.status.generated_at);
  $('#updated').title = fmtT(D.status.generated_at);
  $('#disc').innerHTML = '⚠️ ' + esc(D.status.disclaimer) + ' Data: ' + esc(D.status.data_source) + '. Paper-trade PnL is hypothetical.';
}
const M = () => (D.status && D.status.markets) || {};
const REGIONS = ['Americas', 'Europe', 'Asia-Pacific'];
function marketMatch(code, f) {
  if (!f || f === 'all') return true;
  if (REGIONS.includes(f)) return (M()[code] || {}).region === f;
  return code === f;
}
function marketOptions(sel, withRegions = true) {
  let h = `<option value="all">All markets</option>`;
  if (withRegions) h += REGIONS.map(r => `<option value="${r}" ${sel === r ? 'selected' : ''}>${r === 'Americas' ? '🌎' : r === 'Europe' ? '🌍' : '🌏'} ${r}</option>`).join('');
  h += Object.values(M()).map(m => `<option value="${m.code}" ${sel === m.code ? 'selected' : ''}>${m.flag} ${m.code} – ${esc(m.name)}</option>`).join('');
  return h;
}

