  const row = (lab, s) => `<tr><td>${lab}</td><td class="r">${s.trades}</td><td class="r">${s.win_rate ?? '–'}%</td><td class="r ${cls(s.avg_r)}">${s.avg_r ?? '–'}</td><td class="r ${cls(s.pnl_usd)}">${usd(s.pnl_usd)}</td></tr>`;
