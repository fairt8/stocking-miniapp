/* ---------------- router ---------------- */
function render() {
  const h = location.hash || '#/signals';
  const [, tab, arg] = h.split('/');
  document.querySelectorAll('#tabs a').forEach(a => a.classList.toggle('on', a.dataset.tab === (tab === 's' ? 'signals' : tab)));
  const v = $('#view');
  backButton(tab === 's');
  mainButton(null);
  try {
    if (tab === 's') {
      v.innerHTML = viewDetail(arg);
      const s = (D.signals || []).find(x => String(x.id) === String(arg));
      if (s) { drawChart(s); mainButton(`Live check ${s.ticker} in bot`, () => botCmd('/check ' + s.ticker)); }
    } else if (tab === 'pnl') v.innerHTML = viewPnl();
    else if (tab === 'markets') { v.innerHTML = viewMarkets(); }
    else if (tab === 'backtest') v.innerHTML = viewBacktest();
    else if (tab === 'actions') v.innerHTML = viewActions();
    else v.innerHTML = viewSignals();
  } catch (e) { v.innerHTML = `<div class="card dn">Render error: ${esc(e.message)}</div>`; console.error(e); }
  if (tab !== 's') window.scrollTo(0, 0);
}
document.addEventListener('click', e => {
  const b = e.target.closest('button'); if (!b) return;
  if (b.dataset.cmd) return botCmd(b.dataset.cmd);
  if (b.dataset.f) { F[b.dataset.f] = b.dataset.v; LS.set('filters', F); return render(); }
  if (b.dataset.p) { P.period = b.dataset.p; LS.set('pnlf', P); return render(); }
  if (b.id === 'do-sub') { const c = [...document.querySelectorAll('.subm:checked')].map(x => x.value); LS.set('sub', c); return botCmd('/subscribe' + (c.length ? ' ' + c.join(' ') : '')); }
  if (b.id === 'a-check') { const t = ($('#a-t').value || '').trim().toUpperCase(); if (!t) return toast('Type a ticker first'); return botCmd('/check ' + t); }
  if (b.id === 'a-scan') return botCmd('/scan ' + $('#a-m').value);
});
document.addEventListener('change', e => {
  const id = e.target.id;
  const map = { 'f-market': 'market', 'f-conf': 'conf', 'f-ck': 'ck', 'f-days': 'days', 'f-sort': 'sort' };
  if (map[id]) { F[map[id]] = ['conf', 'ck', 'days'].includes(map[id]) ? Number(e.target.value) : e.target.value; LS.set('filters', F); render(); }
  if (id === 'p-market') { P.market = e.target.value; LS.set('pnlf', P); render(); }
});
let qT; document.addEventListener('input', e => { if (e.target.id === 'f-q') { clearTimeout(qT); qT = setTimeout(() => { F.q = e.target.value; LS.set('filters', F); render(); const q = $('#f-q'); q.focus(); q.setSelectionRange(q.value.length, q.value.length); }, 350); } });
document.addEventListener('keydown', e => { if (e.key === 'Enter' && e.target.id === 'a-t') $('#a-check').click(); });
window.addEventListener('hashchange', render);
