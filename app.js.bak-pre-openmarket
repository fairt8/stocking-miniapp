function css(v, d) { return getComputedStyle(document.documentElement).getPropertyValue(v).trim() || d; }
async function drawChart(s) {
  const el = $('#chart'); if (!el || !window.LightweightCharts) return;
  let bars;
  try { bars = await fetch('data/' + s.chart + '?t=' + Date.now()).then(r => r.ok ? r.json() : null); } catch (e) {}
  if (!bars || !bars.length) { el.innerHTML = '<div class="mut small empty">No chart data published for this ticker.</div>'; return; }
  const tx = css('--tx', '#e6edf3'), sep = 'rgba(127,127,127,.15)';
  const ch = LightweightCharts.createChart(el, { height: 300, width: el.clientWidth, layout: { background: { type: 'solid', color: 'transparent' }, textColor: tx, fontSize: 11 },
    grid: { vertLines: { color: sep }, horzLines: { color: sep } }, rightPriceScale: { borderColor: sep }, timeScale: { borderColor: sep }, handleScroll: true, handleScale: true });
  const c = ch.addCandlestickSeries({ upColor: '#16c784', downColor: '#ea3943', wickUpColor: '#16c784', wickDownColor: '#ea3943', borderVisible: false });
  c.setData(bars);
  const v = ch.addHistogramSeries({ priceFormat: { type: 'volume' }, priceScaleId: '', color: 'rgba(127,127,127,.35)' });
  v.priceScale().applyOptions({ scaleMargins: { top: 0.82, bottom: 0 } });
  v.setData(bars.map(b => ({ time: b.time, value: b.volume })));
  const lo = Math.min(...bars.map(b => b.low)) * 0.85, hi = Math.max(...bars.map(b => b.high)) * 1.15;
  const L = (p, col, title, style, w) => p != null && c.createPriceLine({ price: p, color: col, lineWidth: w || 2, lineStyle: style || 0, axisLabelVisible: true, title });
  L(s.entry, '#4ea1ff', 'entry'); L(s.stop, '#ea3943', 'stop'); L(s.target, '#16c784', 'target');
  (s.levels || []).filter(l => l.price > lo && l.price < hi).forEach(l => L(l.price, '#8b98a5', 'S/R ' + l.touches + '×', 2, 1));
  (s.zones || []).filter(z => z.proximal > lo && z.proximal < hi).slice(0, 4).forEach(z => L(z.proximal, '#e3b341', z.type, 1, 1));
  const bd = bars.find(b => b.time === s.bar_date);
  if (bd) c.setMarkers([{ time: s.bar_date, position: s.action === 'BUY' ? 'belowBar' : 'aboveBar', color: s.action === 'BUY' ? '#16c784' : '#ea3943', shape: s.action === 'BUY' ? 'arrowUp' : 'arrowDown', text: s.action }]);
  ch.timeScale().fitContent();
  new ResizeObserver(() => ch.applyOptions({ width: el.clientWidth })).observe(el);
}

/* PnL: aggregated client-side from trades.json with the same rules as app/pnl.py */
const P = Object.assign({ period: 'all', market: 'all' }, LS.get('pnlf', {}));
function periodStart(p) {
  const today = lagosDate(new Date());
  if (p === 'today') return today;
  const [y, m, d] = today.split('-').map(Number), dt = new Date(Date.UTC(y, m - 1, d));
  if (p === 'week') { dt.setUTCDate(dt.getUTCDate() - ((dt.getUTCDay() + 6) % 7)); return dt.toISOString().slice(0, 10); }
  if (p === 'month') return today.slice(0, 8) + '01';
  return '0000-00-00';
}
function stats(rows) {
  const closed = rows.filter(r => r.status !== 'open'), won = closed.filter(r => r.status === 'won');
  const sum = (a, k) => a.reduce((x, r) => x + (r[k] || 0), 0);
  const o = { closed: closed.length, won: won.length, lost: closed.filter(r => r.status === 'lost').length, expired: closed.filter(r => r.status === 'expired').length,
    win_rate: closed.length ? 100 * won.length / closed.length : null, realized: sum(closed, 'pnl_usd'), avg_r: closed.length ? sum(closed, 'r_mult') / closed.length : null, sum_r: sum(closed, 'r_mult') };
  if (closed.length) { const s = [...closed].sort((a, b) => b.pnl_pct - a.pnl_pct); o.best = s[0]; o.worst = s[s.length - 1]; }
  return o;
}
function viewPnl() {
  const start = periodStart(P.period);
  const all = (D.trades || []).filter(t => marketMatch(t.market, P.market));
  const closed = all.filter(t => t.status !== 'open' && (t.closed_bar || '') >= start), open = all.filter(t => t.status === 'open');
  const S = stats(closed), unreal = open.reduce((x, r) => x + (r.pnl_usd || 0), 0), unrealR = open.reduce((x, r) => x + (r.r_mult || 0), 0);
  const group = k => [...new Set(all.map(t => t[k]))].sort().map(v => { const c = closed.filter(t => t[k] === v), o = open.filter(t => t[k] === v); return [v, stats(c), o.length, o.reduce((x, r) => x + (r.pnl_usd || 0), 0)]; });
  const gtable = (title, rows, lab) => `<div class="card"><b>${title}</b><table><tr><th></th><th class="r">Closed</th><th class="r">Win %</th><th class="r">Avg R</th><th class="r">Realised</th><th class="r">Open</th><th class="r">Unreal.</th></tr>
    ${rows.map(([v, s, no, ou]) => `<tr><td>${lab(v)}</td><td class="r">${s.closed}</td><td class="r">${s.win_rate == null ? '–' : num(s.win_rate, 0)}</td><td class="r ${cls(s.avg_r)}">${s.avg_r == null ? '–' : sgn(s.avg_r)}</td><td class="r ${cls(s.realized)}">${usd(s.realized)}</td><td class="r">${no}</td><td class="r ${cls(ou)}">${usd(ou)}</td></tr>`).join('')}</table></div>`;
  const per = [['today', 'Today'], ['week', 'Week'], ['month', 'Month'], ['all', 'All-time']];
  const tl = (list, empty) => list.length ? `<table><tr><th>Ticker</th><th>Side</th><th class="r">Entry→Px</th><th class="r">%</th><th class="r">R</th><th class="r">$</th></tr>${list.map(t => {
